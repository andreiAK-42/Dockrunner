# Настройки агента воркера (подставляются в контейнер через env_file:
# в docker-compose-services-agent.yml сервис ссылается на этот файл).
# Единственный источник настроек — переменные окружения (config.yaml больше не читается).
# Скопируйте и заполните:  cp env.agent.example env.agent
#
# AGENT_NAME — уникальное имя воркера: оно же id узла в панели
# и имя очереди RabbitMQ agent.<AGENT_NAME>.

# Идентичность
AGENT_NAME=worker-01
# Описание сервера (видно в панели; пусто — не затрёт заданное админом)
AGENT_DESCRIPTION=
# Публичный URL API агента — сюда панель ходит за логами/файлами/спекой
AGENT_PUBLIC_URL=http://worker-01:8090
# Явный внешний IP сервера (показывается в панели; ОБЯЗАТЕЛЕН в docker —
# из контейнера виден только 172.17.0.x)
AGENT_IP=

# Центральный сервер + общий секрет (тот же, что AGENT_TOKEN на бэкенде)
CENTRAL_URL=http://central:8080
AGENT_TOKEN=change-me-agent-shared-secret

# RabbitMQ центральной шины
RABBITMQ_URL=amqp://dockrunner:dockrunner@rabbitmq:5672/
RABBITMQ_TLS_SKIP_VERIFY=false

# Хранение состояния внутри volume agent-data (не менять без необходимости)
SQLITE_PATH=/data/agent.db
WORKSPACE_DIR=/data/workspace
# Тот же workspace глазами docker-демона (хоста). Нужен ТОЛЬКО если путь
# на хосте отличается от пути в контейнере, например:
#   docker volume лежит на хосте в /var/lib/docker/volumes/... — тогда либо
#   задайте реальный хост-путь, либо смонтируйте хостовый каталог вместо
#   named volume (см. dockrunner_agent/DEPLOY.md).
# HOST_WORKSPACE_DIR=/opt/agent-data/workspace

# HTTP API агента
PORT=8090
HEARTBEAT_INTERVAL=15s

# Victoria (метрики агент шлёт сам, логи дублируются; пусто — не отправлять)
VICTORIA_METRICS_URL=http://victoria-metrics:8428
VICTORIA_LOGS_URL=http://victorialogs:9428
VICTORIA_TOKEN=
