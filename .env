# Один .env обслуживает docker-compose.yml (backend + frontend)
# и docker-compose-services.yml (инфраструктура) — compose читает его по умолчанию.
# Скопируйте и заполните:  cp .env.example .env

# ===================== Бэкенд =====================
APP_ENV=production
PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
LOG_LEVEL=info

# База и шина — имена сервисов из docker-compose-services.yml, НЕ localhost
POSTGRES_URL=postgres://dockrunner:dockrunner@postgres:5432/dockrunner?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE=5m
POSTGRES_HEALTH_CHECK_PERIOD=1m
RABBITMQ_URL=amqp://dockrunner:dockrunner@rabbitmq:5672/
RABBITMQ_TLS_SKIP_VERIFY=false

# Victoria: метрики пишут агенты, логи шлёт бэкенд (токен — Bearer для vmauth, в доверенной сети можно пусто)
VICTORIA_METRICS_URL=http://victoria-metrics:8428
VICTORIA_METRICS_TOKEN=
VICTORIA_LOGS_URL=http://victorialogs:9428
VICTORIA_LOGS_TOKEN=

# Секреты — ЗАМЕНИТЬ на длинные случайные значения
JWT_SECRET=change-me-super-secret-key-32-chars-min-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=10
AGENT_TOKEN=change-me-agent-shared-secret

# Первый админ (создаётся при пустой таблице users)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# CORS: адреса, с которых открывается панель, через запятую
# (иначе браузер заблокирует запросы). Пример: http://82.179.9.27
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Диапазон хост-портов пользовательских контейнеров
PORTS_MIN=3000
PORTS_MAX=4000

# ===================== Фронтенд =====================
# URL бэкенда ВШИВАЕТСЯ в сборку (браузер ходит в API напрямую).
VITE_API_URL=http://localhost:8080

# ===================== Инфраструктура (docker-compose-services.yml) =====================
# Пароль в POSTGRES_URL выше должен совпадать с POSTGRES_PASSWORD
POSTGRES_USER=dockrunner
POSTGRES_PASSWORD=dockrunner
POSTGRES_DB=dockrunner
RABBITMQ_DEFAULT_USER=dockrunner
RABBITMQ_DEFAULT_PASS=dockrunner
# Хранение логов в victorialogs (например 30d, 12w)
RETENTION=30d
# Домен для caddy (публичный доступ к VictoriaLogs/Grafana и т.п.)
DOMAIN=example.com
# Общий Bearer-токен для caddy/vmauth (если используется)
VICTORIA_TOKEN=
