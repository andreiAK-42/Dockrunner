# Agent identity
AGENT_ID=worker-01
AGENT_NAME=worker-01
# Описание сервера (видно в панели; пусто — не затрёт заданное админом)
# AGENT_DESCRIPTION=Основной сервер, Frankfurt
# Город и координаты для карты (пусто — маркер без места)
# AGENT_CITY=Frankfurt
# AGENT_LAT=50.1109
# AGENT_LNG=8.6821
# Публичный URL API агента для панели (логи, файлы)
# AGENT_PUBLIC_URL=http://worker-01:8090
# Явный внешний IP сервера (показывается в панели, используется в адресах портов).
# ОБЯЗАТЕЛЕН, если агент запущен в docker: из контейнера виден только 172.17.0.x.
# AGENT_IP=147.45.210.164

# Central backend + shared secret
CENTRAL_URL=http://localhost:8080
AGENT_TOKEN=change-me-shared-secret

# RabbitMQ (central bus). Порт 5671 обычно означает TLS — тогда схема amqps://
RABBITMQ_URL=amqp://dockrunner:dockrunner@localhost:5672/
# RABBITMQ_URL=amqps://dockrunner:dockrunner@localhost:5671/
# RABBITMQ_TLS_SKIP_VERIFY=true — только для самоподписанного серта

# Local state + project sources (workspace/<owner>/<project>)
SQLITE_PATH=./data/agent.db
WORKSPACE_DIR=./workspace
# Тот же workspace глазами docker-демона (хоста). Нужен ТОЛЬКО если агент
# в контейнере и путь внутри отличается от хостового, например:
#   docker run -v /opt/agent-data:/data ...  (WORKSPACE_DIR=/data/workspace)
#   HOST_WORKSPACE_DIR=/opt/agent-data/workspace
# Альтернатива без этой переменной — монтировать тот же путь:
#   docker run -v /opt/agent-data:/opt/agent-data ...
#   WORKSPACE_DIR=/opt/agent-data/workspace
# Пусто = трансляции нет (агент бинарником на хосте).
# HOST_WORKSPACE_DIR=/opt/agent-data/workspace

# Agent API
PORT=8090
HEARTBEAT_INTERVAL=15s

# Docker (empty = /var/run/docker.sock)
# DOCKER_HOST=tcp://localhost:2375
