# App
APP_ENV=development
PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Logging: все логи — в LOG_DIR/app.log, в терминал — только важное
# (запуск/остановка и Warn+). Пусто — файлы не пишутся.
LOG_DIR=logs
# LOG_LEVEL=info

# Postgres (OLTP)
POSTGRES_URL=postgres://dockrunner:dockrunner@localhost:5432/dockrunner?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE=5m
POSTGRES_HEALTH_CHECK_PERIOD=1m

# InfluxDB (metrics)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dockrunner-influx-token
INFLUX_ORG=dockrunner
INFLUX_BUCKET=metrics
INFLUX_TIMEOUT=5s

# RabbitMQ (async tasks). Порт 5671 обычно означает TLS — тогда схема amqps://
# RABBITMQ_URL=amqps://dockrunner:dockrunner@localhost:5671/
# RABBITMQ_TLS_SKIP_VERIFY=true — только для самоподписанного серта
RABBITMQ_URL=amqp://dockrunner:dockrunner@localhost:5672/

# Auth
JWT_SECRET=change-me-super-secret-key-32-chars-min-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=10
AGENT_TOKEN=change-me-agent-shared-secret

# Seed admin (created on first start if users table is empty)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID

# Rate limiter
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

PORTS_MIN=3000
PORTS_MAX=4000

# Managed databases: строки подключения для пользователей и admin-доступ для провижининга.
# Без admin-URL создание пользователей вернёт честную ошибку «СУБД недоступна».
DB_POSTGRES_HOST=pg.dockrunner.local
DB_POSTGRES_PORT=5432
DB_POSTGRES_NAME=appdb
DB_POSTGRES_ADMIN_URL=postgres://dbadmin:change-me@pg.dockrunner.local:5432/postgres?sslmode=disable
DB_MONGO_HOST=mongo.dockrunner.local
DB_MONGO_PORT=27017
DB_MONGO_NAME=appdb
DB_MONGO_ADMIN_URL=mongodb://dbadmin:change-me@mongo.dockrunner.local:27017/admin
DB_REDIS_HOST=redis.dockrunner.local
DB_REDIS_PORT=6379
DB_REDIS_PASSWORD=change-me-redis-admin-password